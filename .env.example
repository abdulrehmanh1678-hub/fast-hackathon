# ================================================================
# Unified Business Management Platform - Environment Variables
# ================================================================

# Application & Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_db?schema=public"

# Auth & Cryptography (AES-256-GCM requires 32-byte hex key = 64 hex chars)
SESSION_SECRET=super_secret_session_key_min_32_characters_long_for_security!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Twilio (Messaging - WhatsApp / SMS)
TWILIO_ACCOUNT_SID=AC_dummy_twilio_account_sid
TWILIO_AUTH_TOKEN=dummy_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# SafePay (Payments)
SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_API_KEY=your_safepay_public_api_key
SAFEPAY_SECRET_KEY=your_safepay_private_api_secret
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_signing_secret

# Google OAuth 2.0 (Google Calendar)
GOOGLE_CLIENT_ID=dummy_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Telegram (Notifications Provider - I4)
TELEGRAM_BOT_TOKEN=dummy_telegram_bot_token


# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=generate_a_random_token
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_WORKSPACE_SLUG=acme
